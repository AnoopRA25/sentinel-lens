# =====================================================================
# Sentinel Lens v2.0 - Environment Configuration Template
# Copy this file to '.env' and populate your credentials.
# RULE R9: Never commit secrets, API keys, or bot tokens to Git.
# =====================================================================

# --- Vision Model API Credentials ---
# Free API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Optional Telegram Caregiver Dispatch Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATIONS_ENABLED=false
NOTIFY_MIN_LEVEL=high
NOTIFY_COOLDOWN_SECONDS=900

# --- Pipeline Configuration & Safety Bounds ---
PIPELINE_VERSION=v2
MAX_UPLOAD_MB=10
MAX_IMAGE_SIDE=1600
GEMINI_TIMEOUT_SECONDS=30
MAX_RETRIES=1
DEEP_SCAN_MAX_CALLS=4
VERIFIER_USE_LLM=false
ALLOW_AI_GENERAL_PRECAUTIONS=false

# --- Server & Access Security ---
ALLOWED_ORIGINS=*
ACCESS_TOKEN=
EMERGENCY_NUMBER=

