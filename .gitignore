# =====================================================================
# Sentinel Lens v2.0 - Git Ignore Rules
# =====================================================================

# --- Environments & Secrets (Rule R9: Strict secret isolation) ---
.env
.env.*
!.env.example
.venv/
.venv*/
venv/
env/
ENV/

# --- Python Caches & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node & NPM Dependencies (No node_modules in repository) ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/.vite/
*.tsbuildinfo

# Allow frontend pre-compiled distribution assets
!frontend/dist/
!frontend/dist/**

# Ensure frontend/src/lib is tracked
!frontend/src/lib/
!frontend/src/lib/**

# --- Test Caches & Coverage ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Archive & Temporary Binary Files ---
*.log
*.zip
*.tar.gz
*.obj
*.def
/tmp/*.lib

# --- Private Fixtures (Preserve public benchmark dataset) ---
tests/fixtures/private/
